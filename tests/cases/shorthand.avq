import "std/strings"

struct Item { name: Str, tags: [Str] }

fn classify(b: Int) -> Str {
  return if is_digit(b) then "digit" else if is_letter(b) then "letter" else "other"
}

fn main() uses io {
  let s = "ab1 z"
  var digits = 0
  for ch in s {
    if is_digit(ch) { digits += 1 }
  }
  print(digits, s[0], s[0] == 'a', '\n', ' ', '\'', classify(s[2]), classify('-'))
  var total = 0
  for i, x in [10, 20, 30] {
    total += i * x
  }
  total -= 5
  total *= 2
  total /= 3
  total %= 50
  print(total, s[1..3], pad_left("7", 3, "0"), pad_right("ab", 4, "."))
  var items = [Item(name: "a", tags: ["x", "y"]), Item(name: "b", tags: [])]
  var n = 0
  for it in items {
    for tag in it.tags { n += len(tag) }
    n += len(it.name)
  }
  var grid = [[1, 2], [3]]
  grid[0][1] += 40
  items[1].name += "!"
  for row in grid {
    for v in row { n += v }
  }
  for w in split("p q r", " ") { n += len(w) }
  let big = if n > 10 then n * 2 else -n
  print(n, items[1].name, big, if total > 0 then "pos" else "neg")
}
