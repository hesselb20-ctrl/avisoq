// Big integers, checked against values computed outside Avisoq.
import "std/bigint"

fn show(x: Str, y: Str) uses io {
  let a = big(x)
  let b = big(y)
  print(
    big_str(big_add(a, b)),
    big_str(big_sub(a, b)),
    big_str(big_mul(a, b)),
    big_str(big_div(a, b)),
    big_str(big_rem(a, b)),
    big_cmp(a, b),
  )
}

fn main() uses io {
  show("0", "1")
  show("0", "-7")
  show("7", "2")
  show("-7", "2")
  show("7", "-2")
  show("-7", "-2")
  show("999999999", "1")
  show("1000000000", "999999999")
  show("-1000000000000000000", "1000000000")
  show("9223372036854775807", "9223372036854775807")
  show("-9223372036854775808", "-1")
  show("100000000000000000000000000000", "100000000000000000000000000001")
  show("123456789", "123456789123456789")
  show("969083009954567", "-58")
  show("-17831914411670692533573186394", "95414106715")
  show("-44685479382297202872574332826642531347872650785807499", "889908292986")
  show("20017034915545062417741", "-6")
  show("464236307567522970350594909249219130516940840572358", "-1019586716209538850489729")
  show(
    "35846784223378417468187443034260897068173318304448370545124",
    "-34126887916732791424032902743571675",
  )
  show("-97142880", "-92")
  show("16649314088431982473455", "-3691641483")
  show("-75", "9183245561137194154724336")
  show("-8014001", "-7259")
  show("611960938836", "-897741019974854141879995457")
  show("381783069764361421222723605097435893", "7672")
  show("-191624850205996910814676705366570189", "350")
  show("-51841308181695994485320168303121281694", "-176363417294199025149063812709216611520")
  show("-6020228680160110435099553161792424707703955616885169", "7617191442648506")
  show("-27106150728914235649", "-36")
  show("699328343300446263851480", "85834780068778989917398695632")
  show("875053076686299160016013782256312083909107171908334785", "542750630964651137516233560")
  show("-27614117338481216362003143423752422009831539127725731", "-1816")
  show("91633971028284346758566840597539202038", "-122079358572")
  show("202798284873", "468610190124455416459")
  show("-6727059270131583310195502", "8733")
  show("-617453226310932", "-174241533")
  show("-3896068150907956245870525706291045066110025", "145936006579753293149776436372993925436")
  show("-8513578378384672938217591613653683460345", "5356")
  show("-15434357350113668119619503775", "-65100969530701411891824876116443609")
  show("886593340311594258919999859278", "-1585971183021262")
  show("-32368774547092385677610625952260515", "5")
  show("466773611", "-197434663687101018893227537738")
  show("3254314630280651387566537523407", "-12863724325576761")
  show("-758010322249350885726451647231140573625070585722778319817", "-54")
  show("7884515831000935288461418715969584254712739014363410", "-1647")
  show("7213499276828547028760391619335610786482746291527444", "183467660346598767249542076511371")
  show("3124043129", "-6")
  show("-34499012981920392355925037606808", "-43637144901")
  show("-22604131876604973687972169648351334161123600", "485016162575781638841838380567165796")
  show("942394679428324081412084787417561258327052652", "-6081")
  show("8868304725812852418320937414946601841", "27053411906730590199600478195805260978")
  show("796547251", "-46071768364444937130396")
  show("172607646483918564465328398485", "-7")
  print(
    big_str(big_pow(big("2"), 200)),
    big_str(big_pow(big("-3"), 5)),
    big_str(big_pow(big("12345"), 0)),
  )
  print(
    big_str(big_from_int(-9223372036854775808)),
    big_str(big_from_int(0)),
    big_str(big_from_int(1000000000)),
    big_str(big_neg(big("5"))),
    big_str(big_abs(big("-5"))),
  )
  print(
    unwrap_or(big_to_int(big("-9223372036854775808")), 1),
    unwrap_or(big_to_int(big("9223372036854775808")), 1),
    is_some(big_parse("12x")),
    is_some(big_parse("-")),
    is_some(big_parse("")),
    big_str(big("-000")),
    big_eq(big("0010"), big("10")),
    big_is_zero(big("0")),
  )
}
