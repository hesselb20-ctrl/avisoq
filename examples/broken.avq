// Deliberately wrong: run `avisoq check examples/broken.avq --json` to see the diagnostics.
fn average(xs: [Int]) -> Float {
  var total = 0
  for i in 0..len(xs) {
    total = total + xs[i]
  }
  print("total", total)
  return total / len(xs)
}

fn main() uses io {
  let data = [3, 5, 8]
  data[0] = 4
  print(average(data))
}
