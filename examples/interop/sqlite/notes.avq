// A real C library from Avisoq: SQLite, through the small binding in sqlite_shim.c.
//
//   avisoq run examples/interop/sqlite/notes.avq --allow io,ffi --native
//
// It needs libsqlite3-0.dll in this folder (see README.md in this folder).
import "std/strings"

extern "sqlite_shim.c" link "libsqlite3-0.dll" fn db_version() -> Str

extern "sqlite_shim.c" fn db_open(path: Str) -> Int

extern "sqlite_shim.c" fn db_close(db: Int)

extern "sqlite_shim.c" fn db_error() -> Str

extern "sqlite_shim.c" fn db_exec(db: Int, sql: Str) -> Bool

extern "sqlite_shim.c" fn db_insert(db: Int, sql: Str, text: Str, number: Int) -> Int

extern "sqlite_shim.c" fn db_query(db: Int, sql: Str, text: Str) -> Str

extern "sqlite_shim.c" fn db_query_ok() -> Bool

struct Note { id: Int, title: Str, stars: Int }

// ---- the binding, with failures as values ----

fn open(path: Str) -> Result[Int, Str] uses ffi {
  let db = db_open(path)
  if db == 0 { return Err(error: "cannot open " + path + ": " + db_error()) }
  return Ok(value: db)
}

fn exec(db: Int, sql: Str) -> Result[Bool, Str] uses ffi {
  if not db_exec(db, sql) { return Err(error: db_error()) }
  return Ok(value: true)
}

fn add_note(db: Int, title: Str, stars: Int) -> Result[Int, Str] uses ffi {
  let id = db_insert(db, "INSERT INTO notes (title, stars) VALUES (?1, ?2)", title, stars)
  if id < 0 { return Err(error: db_error()) }
  return Ok(value: id)
}

// Every row of a query as its columns.
fn rows(db: Int, sql: Str, text: Str) -> Result[[[Str]], Str] uses ffi {
  let raw = db_query(db, sql, text)
  if not db_query_ok() { return Err(error: db_error()) }
  var out: [[Str]] = []
  if len(raw) == 0 { return Ok(value: out) }
  for line in split(raw, "\n") { push(out, split(line, "\t")) }
  return Ok(value: out)
}

fn notes_matching(db: Int, pattern: Str) -> Result[[Note], Str] uses ffi {
  let found = rows(
    db,
    "SELECT id, title, stars FROM notes WHERE title LIKE ?1 ORDER BY stars DESC, id",
    pattern,
  )?
  var out: [Note] = []
  for row in found {
    push(
      out,
      Note(
        id: unwrap_or(parse_int(row[0]), -1),
        title: row[1],
        stars: unwrap_or(parse_int(row[2]), -1),
      ),
    )
  }
  return Ok(value: out)
}

// ---- the program ----

fn work(db: Int) -> Result[Int, Str] uses io, ffi {
  exec(
    db,
    "CREATE TABLE notes (id INTEGER PRIMARY KEY, title TEXT NOT NULL, stars INTEGER NOT NULL)",
  )?
  let titles = [
    "Buy milk",
    "Call Ada",
    "It's a test; DROP TABLE notes; --",
    "Read\tthe 'manual'",
    "Zürich trip",
    "Buy stamps",
  ]
  for i, title in titles {
    let id = add_note(db, title, (i * 7 + 3) % 5)?
    assert id == i + 1
  }
  let everything = notes_matching(db, "%")?
  print("notes:", len(everything))
  for n in everything { print(" ", n.stars, n.id, n.title) }
  let buys = notes_matching(db, "Buy%")?
  print("starting with Buy:", len(buys), buys[0].title, buys[1].title)
  let totals = rows(db, "SELECT COUNT(*), SUM(stars), MAX(length(title)), ?1 FROM notes", "ok")?
  print("count, stars, longest title:", join(totals[0], " "))
  let none = rows(db, "SELECT title FROM notes WHERE title = ?1", "nothing like this")?
  print("no match:", len(none))
  match rows(db, "SELECT nope FROM missing_table WHERE x = ?1", "") {
    Ok(value) => { print("unexpected success") }
    Err(error) => { print("a bad query is an error value:", error) }
  }
  match exec(db, "INSERT INTO notes (title) VALUES ('no stars')") {
    Ok(value) => { print("unexpected success") }
    Err(error) => { print("a broken rule is an error value:", error) }
  }
  return Ok(value: len(everything))
}

fn main() uses io, ffi {
  print("SQLite", if len(db_version()) > 0 then "loaded" else "missing")
  match open(":memory:") {
    Err(error) => { print(error) }
    Ok(db) => {
      match work(db) {
        Ok(count) => { print("done:", count) }
        Err(error) => { print("failed:", error) }
      }
      db_close(db)
    }
  }
}
