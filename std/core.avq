// Core types: a value that may be absent, and a result that may be an error.

enum Option[T] { Some(value: T), None }

enum Result[T, E] { Ok(value: T), Err(error: E) }

// Tuples: (a, b) builds a Tuple2, and the type is written (A, B).
struct Tuple2[A, B] { first: A, second: B }

struct Tuple3[A, B, C] { first: A, second: B, third: C }

struct Tuple4[A, B, C, D] { first: A, second: B, third: C, fourth: D }

fn is_some[T](o: Option[T]) -> Bool {
  match o {
    Some => { return true }
    None => { return false }
  }
}

fn unwrap_or[T](o: Option[T], fallback: T) -> T {
  match o {
    Some(value) => { return copy(value) }
    None => { return copy(fallback) }
  }
}

fn is_ok[T, E](r: Result[T, E]) -> Bool {
  match r {
    Ok => { return true }
    Err => { return false }
  }
}

fn value_or[T, E](r: Result[T, E], fallback: T) -> T {
  match r {
    Ok(value) => { return copy(value) }
    Err => { return copy(fallback) }
  }
}
