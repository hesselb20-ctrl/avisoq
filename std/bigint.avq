// Integers of any size.
//
//   let a = big("123456789012345678901234567890")
//   print(big_str(big_mul(a, big_from_int(1000))))
//
// A BigInt is a value like any other struct. `limbs` holds the magnitude in base one billion,
// least significant part first, with no leading zero parts; zero has no parts and is not negative.
import "std/core"
import "std/strings"

struct BigInt { negative: Bool, limbs: [Int] }

let BIG_BASE = 1000000000

// ---- magnitudes: arrays of base-1e9 parts, least significant first ----

private fn mag_trim(xs: mut [Int]) {
  while len(xs) > 0 and xs[len(xs) - 1] == 0 { pop(xs) }
}

private fn mag_cmp(a: [Int], b: [Int]) -> Int {
  if len(a) != len(b) { return if len(a) < len(b) then -1 else 1 }
  var i = len(a) - 1
  while i >= 0 {
    if a[i] != b[i] { return if a[i] < b[i] then -1 else 1 }
    i -= 1
  }
  return 0
}

private fn mag_add(a: [Int], b: [Int]) -> [Int] {
  if len(a) < len(b) { return mag_add(b, a) }
  var out = array(len(a) + 1, 0)
  var carry = 0
  for i in 0..len(a) {
    var t = a[i] + carry
    if i < len(b) { t += b[i] }
    if t >= BIG_BASE {
      t -= BIG_BASE
      carry = 1
    } else {
      carry = 0
    }
    out[i] = t
  }
  out[len(a)] = carry
  mag_trim(out)
  return out
}

// a - b, for a >= b
private fn mag_sub(a: [Int], b: [Int]) -> [Int] {
  var out = array(len(a), 0)
  var borrow = 0
  for i in 0..len(a) {
    var t = a[i] - borrow
    if i < len(b) { t -= b[i] }
    if t < 0 {
      t += BIG_BASE
      borrow = 1
    } else {
      borrow = 0
    }
    out[i] = t
  }
  mag_trim(out)
  return out
}

private fn mag_mul(a: [Int], b: [Int]) -> [Int] {
  if len(a) == 0 or len(b) == 0 { return [] }
  var out = array(len(a) + len(b), 0)
  for i in 0..len(a) {
    let x = a[i]
    if x == 0 { continue }
    var carry = 0
    for j in 0..len(b) {
      let t = out[i + j] + x * b[j] + carry
      carry = t / BIG_BASE
      out[i + j] = t - carry * BIG_BASE
    }
    out[i + len(b)] = carry
  }
  mag_trim(out)
  return out
}

private fn mag_mul_small(a: [Int], m: Int) -> [Int]
  requires m >= 0 and m < 1000000000
{
  if m == 0 or len(a) == 0 { return [] }
  var out = array(len(a) + 1, 0)
  var carry = 0
  for i in 0..len(a) {
    let t = a[i] * m + carry
    carry = t / BIG_BASE
    out[i] = t - carry * BIG_BASE
  }
  out[len(a)] = carry
  mag_trim(out)
  return out
}

// a divided by a single part m. The quotient goes into `quotient`; the remainder is returned.
private fn mag_div_small(a: [Int], m: Int, quotient: mut [Int]) -> Int
  requires m > 0 and m < 1000000000
{
  var parts = array(len(a), 0)
  var rest = 0
  var i = len(a) - 1
  while i >= 0 {
    let cur = rest * BIG_BASE + a[i]
    parts[i] = cur / m
    rest = cur - parts[i] * m
    i -= 1
  }
  mag_trim(parts)
  for p in parts { push(quotient, p) }
  return rest
}

// Long division of magnitudes (Knuth's algorithm D). The parts of the quotient are stored in
// `quotient`; the remainder is returned.
private fn mag_divmod(a: [Int], b: [Int], quotient: mut [Int]) -> [Int]
  requires len(b) > 0
{
  if mag_cmp(a, b) < 0 { return copy(a) }
  let n = len(b)
  if n == 1 {
    let rest = mag_div_small(a, b[0], quotient)
    if rest == 0 { return [] }
    return [rest]
  }
  // Scale both so the leading part of the divisor is at least half the base: the estimate of
  // each quotient part is then off by at most two.
  let scale = BIG_BASE / (b[n - 1] + 1)
  var u = array(len(a) + 1, 0)
  var carry = 0
  for i in 0..len(a) {
    let t = a[i] * scale + carry
    carry = t / BIG_BASE
    u[i] = t - carry * BIG_BASE
  }
  u[len(a)] = carry
  var v = array(n, 0)
  carry = 0
  for i in 0..n {
    let t = b[i] * scale + carry
    carry = t / BIG_BASE
    v[i] = t - carry * BIG_BASE
  }
  let top = v[n - 1]
  let next = v[n - 2]
  var parts = array(len(a) - n + 1, 0)
  var j = len(a) - n
  while j >= 0 {
    let lead = u[j + n] * BIG_BASE + u[j + n - 1]
    var guess = lead / top
    var left = lead - guess * top
    while guess >= BIG_BASE or guess * next > left * BIG_BASE + u[j + n - 2] {
      guess -= 1
      left += top
      if left >= BIG_BASE { break }
    }
    // u[j..j+n] -= guess * v
    var borrow = 0
    carry = 0
    for i in 0..n {
      let p = guess * v[i] + carry
      carry = p / BIG_BASE
      var t = u[i + j] - (p - carry * BIG_BASE) - borrow
      if t < 0 {
        t += BIG_BASE
        borrow = 1
      } else {
        borrow = 0
      }
      u[i + j] = t
    }
    let last = u[j + n] - carry - borrow
    if last < 0 {
      // the guess was one too large: add the divisor back
      guess -= 1
      var over = 0
      for i in 0..n {
        var t = u[i + j] + v[i] + over
        if t >= BIG_BASE {
          t -= BIG_BASE
          over = 1
        } else {
          over = 0
        }
        u[i + j] = t
      }
      u[j + n] = last + over
    } else {
      u[j + n] = last
    }
    parts[j] = guess
    j -= 1
  }
  mag_trim(parts)
  for p in parts { push(quotient, p) }
  // the remainder is the low n parts of u, scaled back
  var scaled = array(n, 0)
  for i in 0..n { scaled[i] = u[i] }
  mag_trim(scaled)
  var rest: [Int] = []
  let none = mag_div_small(scaled, scale, rest)
  assert none == 0
  return rest
}

// ---- making and showing ----

fn big_zero() -> BigInt {
  return BigInt(negative: false, limbs: [])
}

fn big_from_int(n: Int) -> BigInt {
  var limbs: [Int] = []
  // worked on as a negative number, so the smallest Int needs no special case
  var rest = if n > 0 then -n else n
  while rest != 0 {
    push(limbs, -(rest % BIG_BASE))
    rest = rest / BIG_BASE
  }
  return BigInt(negative: n < 0, limbs: limbs)
}

// Reads a decimal integer of any length, with an optional leading "-". None if s is not one.
fn big_parse(s: Str) -> Option[BigInt] {
  let first = if len(s) > 0 and s[0] == '-' then 1 else 0
  if len(s) == first { return None }
  for i in first..len(s) {
    if not is_digit(s[i]) { return None }
  }
  var limbs: [Int] = []
  var end = len(s)
  while end > first {
    let start = if end - 9 > first then end - 9 else first
    var part = 0
    for i in start..end { part = part * 10 + (s[i] - '0') }
    push(limbs, part)
    end = start
  }
  mag_trim(limbs)
  return Some(value: BigInt(negative: first == 1 and len(limbs) > 0, limbs: limbs))
}

// As big_parse, for text known to be a number: anything else gives zero.
fn big(s: Str) -> BigInt {
  match big_parse(s) {
    Some(value) => { return copy(value) }
    None => { return big_zero() }
  }
}

fn big_str(a: BigInt) -> Str {
  if len(a.limbs) == 0 { return "0" }
  var out = if a.negative then "-" else ""
  var i = len(a.limbs) - 1
  out += str(a.limbs[i])
  i -= 1
  while i >= 0 {
    out += pad_left(str(a.limbs[i]), 9, "0")
    i -= 1
  }
  return out
}

// The value as an Int, or None if it does not fit.
fn big_to_int(a: BigInt) -> Option[Int] {
  if len(a.limbs) > 3 { return None }
  return parse_int(big_str(a))
}

// ---- comparing ----

fn big_is_zero(a: BigInt) -> Bool {
  return len(a.limbs) == 0
}

// -1, 0 or 1 as a is below, equal to or above b.
fn big_cmp(a: BigInt, b: BigInt) -> Int {
  if a.negative != b.negative { return if a.negative then -1 else 1 }
  let c = mag_cmp(a.limbs, b.limbs)
  return if a.negative then -c else c
}

fn big_eq(a: BigInt, b: BigInt) -> Bool {
  return big_cmp(a, b) == 0
}

// ---- arithmetic ----

fn big_neg(a: BigInt) -> BigInt {
  return BigInt(negative: not a.negative and len(a.limbs) > 0, limbs: copy(a.limbs))
}

fn big_abs(a: BigInt) -> BigInt {
  return BigInt(negative: false, limbs: copy(a.limbs))
}

fn big_add(a: BigInt, b: BigInt) -> BigInt {
  if a.negative == b.negative {
    let total = mag_add(a.limbs, b.limbs)
    return BigInt(negative: a.negative and len(total) > 0, limbs: total)
  }
  let c = mag_cmp(a.limbs, b.limbs)
  if c == 0 { return big_zero() }
  if c > 0 {
    let rest = mag_sub(a.limbs, b.limbs)
    return BigInt(negative: a.negative, limbs: rest)
  }
  let other = mag_sub(b.limbs, a.limbs)
  return BigInt(negative: b.negative, limbs: other)
}

fn big_sub(a: BigInt, b: BigInt) -> BigInt {
  return big_add(a, big_neg(b))
}

fn big_mul(a: BigInt, b: BigInt) -> BigInt {
  let product = mag_mul(a.limbs, b.limbs)
  return BigInt(negative: a.negative != b.negative and len(product) > 0, limbs: product)
}

// Quotient (rounded toward zero) and remainder (with the sign of a) in one go, so that
// a == quotient * b + remainder. Dividing by zero stops the program.
fn big_divmod(a: BigInt, b: BigInt) -> (BigInt, BigInt)
  requires len(b.limbs) > 0
{
  var quotient: [Int] = []
  let rest = mag_divmod(a.limbs, b.limbs, quotient)
  let q = BigInt(negative: a.negative != b.negative and len(quotient) > 0, limbs: quotient)
  let r = BigInt(negative: a.negative and len(rest) > 0, limbs: rest)
  return (q, r)
}

fn big_div(a: BigInt, b: BigInt) -> BigInt
  requires len(b.limbs) > 0
{
  var quotient: [Int] = []
  let rest = mag_divmod(a.limbs, b.limbs, quotient)
  assert len(rest) >= 0
  return BigInt(negative: a.negative != b.negative and len(quotient) > 0, limbs: quotient)
}

fn big_rem(a: BigInt, b: BigInt) -> BigInt
  requires len(b.limbs) > 0
{
  var quotient: [Int] = []
  let rest = mag_divmod(a.limbs, b.limbs, quotient)
  return BigInt(negative: a.negative and len(rest) > 0, limbs: rest)
}

fn big_pow(base: BigInt, exponent: Int) -> BigInt
  requires exponent >= 0
{
  var out = big_from_int(1)
  var square = copy(base)
  var left = exponent
  while left > 0 {
    if left % 2 == 1 { out = big_mul(out, square) }
    left = left / 2
    if left > 0 { square = big_mul(square, square) }
  }
  return out
}
