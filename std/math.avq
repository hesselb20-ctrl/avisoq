// Small numeric helpers. min, max and clamp work for Int and Float.

fn min[T: Ord](a: T, b: T) -> T {
  if b < a { return b }
  return a
}

fn max[T: Ord](a: T, b: T) -> T {
  if b > a { return b }
  return a
}

fn clamp[T: Ord](x: T, lo: T, hi: T) -> T
  requires lo <= hi
  ensures result >= lo and result <= hi
{
  if x < lo { return lo }
  if x > hi { return hi }
  return x
}

fn abs(x: Int) -> Int
  ensures result >= 0
{
  if x < 0 { return -x }
  return x
}

fn abs_float(x: Float) -> Float {
  if x < 0.0 { return -x }
  return x
}

fn pow(base: Int, exponent: Int) -> Int
  requires exponent >= 0
{
  var result_so_far = 1
  for i in 0..exponent {
    result_so_far = result_so_far * base
  }
  return result_so_far
}

// The largest and smallest Int.
fn int_max() -> Int {
  return 9223372036854775807
}

fn int_min() -> Int {
  return -9223372036854775808
}

// Arithmetic that reports a result that does not fit in Int as None, where + - * would stop
// the program.
fn checked_add(a: Int, b: Int) -> Option[Int] {
  if b > 0 and a > 9223372036854775807 - b { return None }
  if b < 0 and a < -9223372036854775808 - b { return None }
  return Some(value: a + b)
}

fn checked_sub(a: Int, b: Int) -> Option[Int] {
  if b < 0 and a > 9223372036854775807 + b { return None }
  if b > 0 and a < -9223372036854775808 + b { return None }
  return Some(value: a - b)
}

fn checked_mul(a: Int, b: Int) -> Option[Int] {
  if a == 0 or b == 0 { return Some(value: 0) }
  if a == -1 {
    if b == -9223372036854775808 { return None }
    return Some(value: -b)
  }
  if b == -1 {
    if a == -9223372036854775808 { return None }
    return Some(value: -a)
  }
  // Neither factor is 0 or -1 here, so these divisions cannot fail.
  if a > 0 and b > 0 and a > 9223372036854775807 / b { return None }
  if a < 0 and b < 0 and a < 9223372036854775807 / b { return None }
  if a > 0 and b < 0 and b < -9223372036854775808 / a { return None }
  if a < 0 and b > 0 and a < -9223372036854775808 / b { return None }
  return Some(value: a * b)
}
