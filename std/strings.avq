// String helpers. Positions and lengths are in bytes.
import "std/core"

// True when needle occurs in s starting at byte position at.
fn matches_at(s: Str, at: Int, needle: Str) -> Bool {
  if at < 0 or at + len(needle) > len(s) { return false }
  for j in 0..len(needle) {
    if byte_at(s, at + j) != byte_at(needle, j) { return false }
  }
  return true
}

fn starts_with(s: Str, prefix: Str) -> Bool {
  return matches_at(s, 0, prefix)
}

fn ends_with(s: Str, suffix: Str) -> Bool {
  return matches_at(s, len(s) - len(suffix), suffix)
}

// Position of the first occurrence of needle, or -1.
fn index_of(s: Str, needle: Str) -> Int
  ensures result >= -1
{
  let n = len(needle)
  for i in 0..len(s) - n + 1 {
    if matches_at(s, i, needle) { return i }
  }
  return -1
}

fn contains(s: Str, needle: Str) -> Bool {
  return index_of(s, needle) >= 0
}

fn split(s: Str, separator: Str) -> [Str]
  requires len(separator) > 0
  ensures len(result) >= 1
{
  let n = len(separator)
  var count = 1
  var i = 0
  while i + n <= len(s) {
    if matches_at(s, i, separator) {
      count = count + 1
      i = i + n
    } else {
      i = i + 1
    }
  }
  var parts = array(count, "")
  var start = 0
  var k = 0
  i = 0
  while i + n <= len(s) {
    if matches_at(s, i, separator) {
      parts[k] = substr(s, start, i)
      k = k + 1
      i = i + n
      start = i
    } else {
      i = i + 1
    }
  }
  parts[k] = substr(s, start, len(s))
  return parts
}

fn join(parts: [Str], separator: Str) -> Str {
  if len(parts) == 0 { return "" }
  return join_range(parts, separator, 0, len(parts))
}

// Joins parts[low..high) by halves, so the total copying stays close to the size of the result.
private fn join_range(parts: [Str], separator: Str, low: Int, high: Int) -> Str
  requires low >= 0 and low < high and high <= len(parts)
{
  if high - low == 1 { return parts[low] }
  let middle = low + (high - low) / 2
  return join_range(parts, separator, low, middle) + separator + join_range(parts, separator, middle, high)
}

fn replace(s: Str, from: Str, to: Str) -> Str
  requires len(from) > 0
{
  return join(split(s, from), to)
}

fn repeat(s: Str, times: Int) -> Str
  requires times >= 0
{
  // Doubling: the copying adds up to about twice the size of the result.
  var out = ""
  var piece = s
  var left = times
  while left > 0 {
    if left % 2 == 1 { out = out + piece }
    left = left / 2
    if left > 0 { piece = piece + piece }
  }
  return out
}

private fn is_space(byte: Int) -> Bool {
  return byte == 32 or byte == 9 or byte == 10 or byte == 13
}

// Removes spaces, tabs and line breaks from both ends.
fn trim(s: Str) -> Str {
  var start = 0
  var end = len(s)
  while start < end and is_space(byte_at(s, start)) {
    start = start + 1
  }
  while end > start and is_space(byte_at(s, end - 1)) {
    end = end - 1
  }
  return substr(s, start, end)
}

fn lines(s: Str) -> [Str] {
  return split(s, "\n")
}

// Reads a decimal integer such as "42" or "-7". None if s is not one, or does not fit in Int.
fn parse_int(s: Str) -> Option[Int] {
  var i = 0
  var negative = false
  if len(s) > 0 and byte_at(s, 0) == 45 {
    negative = true
    i = 1
  }
  if len(s) - i < 1 { return None }
  // Built up as a negative number, because the smallest Int has no positive counterpart.
  var value = 0
  while i < len(s) {
    let d = byte_at(s, i) - 48
    if d < 0 or d > 9 { return None }
    if value < -922337203685477580 { return None }
    value = value * 10
    if value < -9223372036854775808 + d { return None }
    value = value - d
    i = i + 1
  }
  if negative { return Some(value: value) }
  if value == -9223372036854775808 { return None }
  return Some(value: -value)
}
